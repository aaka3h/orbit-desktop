{
  "name": "orbit-desktop",
  "version": "0.2.0",
  "description": "A local-first desktop AI workspace with approval-based tools.",
  "author": "Orbit contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "smoke": "node scripts/smoke.mjs",
    "test:local": "tsx scripts/local-smoke.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.4.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "com.orbit.desktop",
    "productName": "Orbit",
    "directories": {
      "output": "release/0.2.0"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Orbit contributors",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "scripts/computer.py",
        "to": "computer.py"
      }
    ]
  }
}
